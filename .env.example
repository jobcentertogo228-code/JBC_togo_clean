NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: the current web app does not use this key. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# In Vercel, set NEXT_PUBLIC_SITE_URL to the production https://*.vercel.app URL.
# Supabase Auth must allow the production /auth/callback and password-reset redirects.
